# Runtime
APP_NAME=PropGate
APP_ENV=production
APP_URL=https://propgate.ru
APP_MODE=api
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=["propgate.ru","localhost","127.0.0.1"]

# Telegram
BOT_TOKEN=replace-with-bot-token
OPS_BOT_TOKEN=
OPS_CHAT_IDS=[]
ADMIN_IDS=[]
MATERIALS_CHANNEL_ID=
MATERIALS_CHANNEL_TITLE=Методички
BOT_DESCRIPTION=PropGate - оплата подписки и управление доступом к закрытым каналам.
BOT_SHORT_DESCRIPTION=Подписка и доступ к закрытым каналам PropGate.

# Database and Redis
DATABASE_URL=postgresql+asyncpg://subscription:replace-with-db-password@postgres:5432/subscription
POSTGRES_DB=subscription
POSTGRES_USER=subscription
POSTGRES_PASSWORD=replace-with-db-password
REDIS_URL=redis://redis:6379/0

# Payment providers
ENABLE_DEV_PAYMENTS=false
ENABLE_TELEGRAM_STARS=true
ENABLE_CRYPTOBOT=false
ENABLE_YOOKASSA=false
TELEGRAM_STARS_PROVIDER_TOKEN=
CRYPTOBOT_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# Webhooks
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_MAX_BODY_BYTES=1000000
WEBHOOK_REPLAY_TTL_SECONDS=259200
YOOKASSA_ALLOWED_IPS=[]
TRUSTED_PROXY_IPS=[]

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Legal
TERMS_URL=https://propgate.ru/terms
PRIVACY_URL=https://propgate.ru/privacy
REFUND_POLICY_URL=https://propgate.ru/refunds
LEGAL_VERSION=1
SUPPORT_CONTACT=
SUPPORT_CONTACTS=[]
SUPPORT_IDS=[]

# Monitoring and scheduler
NOTIFICATION_DAYS=[3,1]
SCHEDULER_INTERVAL_MINUTES=10

# Backups
BACKUP_RETENTION_COUNT=14
