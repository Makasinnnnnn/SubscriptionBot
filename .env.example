ADMIN_PASSWORD=
ENABLE_DEV_PAYMENTS=true
ENABLE_TELEGRAM_STARS=true
ENABLE_CRYPTOBOT=false
ENABLE_YOOKASSA=false
TERMS_URL=
PRIVACY_URL=
REFUND_POLICY_URL=
LEGAL_VERSION=1
SUPPORT_CONTACT=
