APP_NAME=SubscriptionBot
APP_ENV=development
APP_URL=http://localhost:8000
APP_MODE=api
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_HOSTS=["*"]

BOT_TOKEN=
OPS_BOT_TOKEN=
OPS_CHAT_IDS=[]
